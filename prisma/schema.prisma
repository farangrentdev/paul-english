// Pavel English — schema (SQLite).
// Списки (awards/feats/tags/goals/days) хранятся как JSON-строки — см. lib/json.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── CMS-контент ────────────────────────────

// Singleton (id = 1): hero-преподаватель, about, контакты, футер.
model SiteSettings {
  id            Int      @id @default(1)
  logoUrl       String?  // картинка-логотип; если пусто — текстовый логотип
  teacherName   String   @default("Павел")
  teacherRole   String   @default("Преподаватель английского · автор методики")
  tagline       String   @default("Английский, который наконец-то заговорит")
  awards        String   @default("[]") // JSON: string[]
  heroPhotoUrl  String   @default("/uploads/pavel.jpg")
  heroBadge     String   @default("«Учитель\nгода» ×4") // жёлтый круглый бейдж на фото
  aboutLead     String   @default("")
  aboutBody     String   @default("[]") // JSON: string[] (абзацы)
  reviewsScore  String   @default("4.9")
  reviewsCount  String   @default("120+ оценок")
  email         String   @default("hello@pavelenglish.ru")
  phone         String   @default("+7 (000) 000-00-00")
  telegram      String   @default("@pavelenglish")
  socials       String   @default("[]") // JSON: {label,url}[]
  footerLegal   String   @default("© 2026 Paul English · ИП Петров П. П. · ИНН 000000000000")
  updatedAt     DateTime @updatedAt
}

model Benefit {
  id    Int    @id @default(autoincrement())
  n     String
  title String
  desc  String
  order Int    @default(0)
}

model LessonType {
  id    Int    @id @default(autoincrement())
  tag   String
  title String
  desc  String
  dur   String
  who   String
  order Int    @default(0)
}

model Package {
  id          Int     @id @default(autoincrement())
  name        String
  price       String  // отображаемая строка, напр. "11 200 ₽"
  priceAmount Int     @default(0) // сумма в рублях для оплаты (0 = бесплатно/проба)
  lessonsCount Int    @default(0) // сколько занятий даёт пакет (для учёта остатка)
  per         String
  popular     Boolean @default(false)
  accent      Boolean @default(false)
  feats       String  @default("[]") // JSON: string[]
  cta         String
  note        String
  isTrial     Boolean @default(false) // первая карточка → форма записи, а не оплата
  order       Int     @default(0)
}

model Promo {
  id    Int    @id @default(autoincrement())
  big   String
  title String
  desc  String
  order Int    @default(0)
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  name     String
  role     String
  tags     String  @default("[]") // JSON: string[]
  note     String
  photoUrl String?
  hero     Boolean @default(false)
  // Участвует в онлайн-записи: у такого педагога есть своё расписание.
  takesBookings Boolean @default(false)
  order    Int     @default(0)

  workingSlots WorkingSlot[]
  slots        ScheduleSlot[]
  lessons      Lesson[]
}

model Review {
  id        Int     @id @default(autoincrement())
  name      String
  who       String
  stars     Int     @default(5)
  text      String
  published Boolean @default(true)
  order     Int     @default(0)
}

model Faq {
  id    Int    @id @default(autoincrement())
  q     String
  a     String
  order Int    @default(0)
}

model Material {
  id        Int     @id @default(autoincrement())
  tag       String
  title     String
  desc      String
  size      String
  fileUrl   String?
  published Boolean @default(true)
  order     Int     @default(0)
}

model LegalDoc {
  id    Int    @id @default(autoincrement())
  key   String @unique // privacy | consent | reqs
  title String
  body  String @default("[]") // JSON: string[] (абзацы)
  order Int    @default(0)
}

// ──────────────────────────── Операционные ────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  role         String   @default("student") // student | admin
  packageName  String?  // активный пакет (для кабинета)
  createdAt    DateTime @default(now())

  lessons   Lesson[]
  journal   JournalEntry[]
  materials StudentMaterial[]
  payments  Payment[]
  slots     ScheduleSlot[]
  family    FamilyMember[]
  purchases PackagePurchase[]
}

// Кто именно занимается на аккаунте: сам владелец и/или его дети, близкие.
// Аккаунт и оплата — общие, эти записи справочные: педагог знает, с кем урок.
model FamilyMember {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  name     String
  relation String  @default("Сам") // Сам | Сын | Дочь | Супруг(а) | Другое
  note     String? // возраст, уровень, особенности — что важно педагогу
  isSelf   Boolean @default(false)
  order    Int     @default(0)

  lessons Lesson[]
  slots   ScheduleSlot[]
}

// Купленный пакет: сколько занятий даёт и сколько уже израсходовано.
model PackagePurchase {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  packageName  String
  lessonsTotal Int
  lessonsUsed  Int      @default(0)
  note         String?
  createdAt    DateTime @default(now())
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentId    String?  @unique

  lessons Lesson[]
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  contactType  String // Telegram | WhatsApp | Звонок | Email
  contactValue String
  level        String?
  goals        String   @default("[]") // JSON: string[]
  days         String   @default("[]") // JSON: string[]
  time         String?
  status       String   @default("new") // new | contacted | booked | done
  createdAt    DateTime @default(now())
}

model Lesson {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  dateLabel String
  date     String? // "2026-08-17" — есть у занятий, созданных из записи
  time     String
  topic    String
  status   String @default("plan") // soon | plan | done | canceled
  order    Int    @default(0)

  // Кто ведёт и кто занимается
  teacher   TeamMember? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId Int?
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId  String?

  // Из какого пакета списывается (списание происходит при статусе done)
  purchase   PackagePurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseId String?
  countedAt  DateTime? // когда занятие фактически списали — защита от двойного списания

  slot ScheduleSlot?
}

model JournalEntry {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  date   String
  topic  String
  mark   String
  note   String
  order  Int    @default(0)
}

model StudentMaterial {
  id      String  @id @default(cuid())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  tag     String
  title   String
  size    String
  fileUrl String?
  order   Int     @default(0)
}

model Payment {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  packageName String
  period      String
  amount      Int
  status      String    @default("pending") // pending | paid | failed | canceled
  yookassaId  String?   @unique
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  purchase PackagePurchase?
}

// Стандартное расписание преподавателя: какие окошки он в принципе ведёт.
// По нему админ «раскатывает» слоты на выбранный период.
model WorkingSlot {
  id        Int        @id @default(autoincrement())
  teacher   TeamMember @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId Int
  weekday   Int // 1=Пн … 7=Вс (ISO)
  time      String // "19:00"
  enabled   Boolean    @default(true)

  @@unique([teacherId, weekday, time])
}

// Конкретный слот на дату у конкретного преподавателя.
// Создаётся админом (раскаткой периода), затем бронируется учеником.
model ScheduleSlot {
  id        String     @id @default(cuid())
  teacher   TeamMember @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId Int
  date      String // "2026-08-17" (YYYY-MM-DD, без TZ-сюрпризов)
  time      String // "19:00"
  status    String     @default("open") // open | booked | closed

  bookedBy       User?         @relation(fields: [bookedByUserId], references: [id], onDelete: SetNull)
  bookedByUserId String?
  member         FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId       String?
  lesson         Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId       String?       @unique

  createdAt DateTime @default(now())

  @@unique([teacherId, date, time])
  @@index([date])
}

// Настройки приёма платежей. Singleton (id = 1).
// Секретный ключ хранится зашифрованным — см. lib/crypto.ts.
model PaymentSettings {
  id             Int      @id @default(1)
  provider       String   @default("yookassa") // yookassa | yomoney
  shopId         String   @default("")
  secretKeyEnc   String?  // зашифрованный секретный ключ
  liveMode       Boolean  @default(false) // false = тестовый магазин ЮKassa
  enabled        Boolean  @default(false) // выключено → демо-режим оплаты
  lastCheckedAt  DateTime?
  lastCheckOk    Boolean?
  lastCheckError String?
  updatedAt      DateTime @updatedAt
}
